# ── Banco MariaDB/MySQL ───────────────────────────────────────────
MYSQL_DATABASE=botcdp
# IMPORTANTE: Troque esta senha antes de fazer deploy! Gere com `openssl rand -base64 24`
MYSQL_ROOT_PASSWORD=CHANGE_ME_use_a_strong_password
# Usuário de aplicação com privilégios restritos ao banco MYSQL_DATABASE (o backend NÃO usa root)
MYSQL_APP_USER=botcdp_app
MYSQL_APP_PASSWORD=CHANGE_ME_use_a_strong_password
MYSQL_PORT=3306
DB_DIALECT=mysql

# ── URLs ──────────────────────────────────────────────────────────
# Para produção, use o domínio completo com HTTPS
BACKEND_URL=https://agentes.casadosparafusosvta.com
FRONTEND_URL=https://agentes.casadosparafusosvta.com
BACKEND_PORT=9000
FRONTEND_PORT=9001
PROXY_PORT=443

# ── JWT ───────────────────────────────────────────────────────────
# IMPORTANTE: Gere secrets fortes com `openssl rand -hex 32`
# NUNCA use os valores abaixo em produção!
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_RESET_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── WhatsApp ──────────────────────────────────────────────────────
# Opções: whaileys (Baileys) | wwebjs (whatsapp-web.js)
WHATSAPP_PROVIDER=whaileys

TZ=America/Sao_Paulo
